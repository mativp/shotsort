{
  "name": "shotsort",
  "version": "1.0.1",
  "description": "Sort a folder of camera photos and video into one folder per shooting day, using the date inside each file.",
  "type": "module",
  "bin": {
    "shotsort": "bin/shotsort.mjs"
  },
  "files": [
    "bin",
    "cli",
    "src",
    "man",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\"",
    "test:unit": "node --test \"test/unit/**/*.test.mjs\"",
    "test:disk": "node --test \"test/disk/**/*.test.mjs\"",
    "test:cli": "node --test \"test/cli/**/*.test.mjs\"",
    "test:contract": "node --test \"test/contract/**/*.test.mjs\"",
    "test:oracle": "node --test \"test/oracle/**/*.test.mjs\"",
    "lint": "eslint .",
    "coverage": "node --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test \"test/**/*.test.mjs\"",
    "coverage:badges": "node --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-reporter=lcov --test \"test/**/*.test.mjs\" | node .github/scripts/coverageBadges.mjs coverage/badges",
    "coverage:check": "node --experimental-test-coverage --test-coverage-lines=90 --test-coverage-branches=90 --test-coverage-functions=90 --test-coverage-exclude=\"test/**\" --test \"test/**/*.test.mjs\"",
    "prepublishOnly": "npm run lint && npm test"
  },
  "keywords": [
    "photo",
    "video",
    "raw",
    "exif",
    "dng",
    "dcim",
    "sort",
    "import",
    "cli"
  ],
  "author": "Mateusz Szwedkowicz <mat.szwedkowicz@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mativp/shotsort.git"
  },
  "homepage": "https://github.com/mativp/shotsort#readme",
  "bugs": "https://github.com/mativp/shotsort/issues",
  "funding": "https://buymeacoffee.com/mativp",
  "man": [
    "man/shotsort.1"
  ],
  "devDependencies": {
    "eslint": "^10.10.0"
  }
}
